# Clave de la API de Deepseek (https://platform.deepseek.com)
# La usa el gestor y, si hay override de modelo abajo, las sesiones kimi
DEEPSEEK_API_KEY=

# Modelo del gestor (el que decide y actúa sobre las sesiones)
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Override OPCIONAL del modelo de las sesiones kimi.
# Vacío (o comentado) = cada sesión usa la configuración propia de kimi.
# Si se pone, se exporta KIMI_MODEL_* dentro de la sesión con esta base URL y key.
KIMI_SESSION_MODEL=
# KIMI_SESSION_BASE_URL=https://api.deepseek.com/v1

# CLI de agente con el que se lanzan las sesiones nuevas (kimi, claude, codex...)
SESSION_CLI=kimi

# Puerto de la web local
PORT=3000

# Interfaz donde escucha la web. La web NO tiene autenticación:
# 127.0.0.1 = solo accesible desde esta máquina (recomendado)
# 0.0.0.0   = accesible desde toda la red (PELIGROSO sin un proxy con auth)
HOST=127.0.0.1

# Bot de Matrix OPCIONAL: hablar con el gestor desde el móvil (sala SIN cifrar;
# el bot no implementa E2EE). Sin estas claves el bot no arranca.
# Solo responde a los MXIDs de MATRIX_ALLOWED_USERS (separados por comas).
# MATRIX_HOMESERVER=https://tu-synapse.example.com
# MATRIX_USER=@lsd-bot:tu-synapse.example.com
# MATRIX_ACCESS_TOKEN=
# MATRIX_ALLOWED_USERS=@tu-usuario:tu-synapse.example.com

# Destinos de despliegue SSH (botón ⬆ Subir de cada sesión): JSON array.
# La autenticación es por la clave SSH del usuario (ssh-copy-id antes; sin
# contraseña — la web nunca toca claves privadas). El despliegue lo ejecuta el
# agente de la sesión por SSH, orquestado por el gestor. Editable también desde
# ⚙ Configuración → Despliegue SSH. Vacío/comentado = botón ⬆ desactivado.
# DEPLOY_TARGETS=[{"name":"farnsworth","user":"andres","host":"10.13.0.1","port":22,"basePath":"/var/www"}]

# Publicación web (botón 🌐 Publicar, solo en sesiones con index.html o
# package.json): destino ÚNICO con auth por CONTRASEÑA (requiere sshpass en
# este equipo). El gestor sube la web a https://<subdominio>.<PUBLISH_DOMAIN>
# (rsync + nginx + certbot); el usuario solo elige el subdominio.
# PUBLISH_HOST vacío = el servidor es el propio dominio.
# La contraseña solo vive aquí (este archivo debe tener permisos 600).
# Editables también desde ⚙ Configuración → Publicación web.
# PUBLISH_DOMAIN=kiokao.com
# PUBLISH_HOST=
# PUBLISH_USER=
# PUBLISH_PASSWORD=
# PUBLISH_BASE_PATH=/var/www
# PUBLISH_PORT=22
